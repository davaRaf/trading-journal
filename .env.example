# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.

# Строка подключения Postgres (Neon: Dashboard -> Connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Токен бота от @BotFather. Без него сайт работает, но напоминаний и вопросов не будет.
BOT_TOKEN=

# Имя бота без @. Можно не заполнять: bot.py узнает его сам при первом запуске.
BOT_USERNAME=

# Ключ подписи сессий. Пусто — сгенерируется локальный в data/.session_secret.
SESSION_SECRET=

# Порт сайта.
PORT=8172
