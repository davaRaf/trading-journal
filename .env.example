# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.

# Строка подключения Postgres (Neon: Dashboard -> Connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Токен бота от @BotFather. Без него сайт работает, но напоминаний и вопросов не будет.
BOT_TOKEN=

# Имя бота без @. Можно не заполнять: bot.py узнает его сам при первом запуске.
BOT_USERNAME=

# Ключ подписи сессий. Пусто — сгенерируется локальный в data/.session_secret.
SESSION_SECRET=

# Адрес журнала — бот даёт эту ссылку, когда объясняет, как привязать аккаунт.
# Пусто — подставится боевой адрес на Railway.
SITE_URL=

# Порт сайта.
PORT=8172

# Сколько одновременных посетителей обслуживаем, не ставя в очередь.
# 64 хватает с запасом; меньше ставят только на совсем слабом сервере.
WEB_WORKERS=64

# Сколько соединений с базой держим открытыми. Больше WEB_WORKERS смысла нет.
DB_POOL_MAX=16

# Фоновые дела (дневной снимок журнала, перечитывание Notion). Должны идти
# ровно в одной копии сайта: если когда-нибудь запустим вторую — ей RUN_JOBS=0.
RUN_JOBS=1

# Ключ DeepSeek API (platform.deepseek.com) — им говорят «Помічник» на сайте
# (static/assistant.js -> /api/assistant/ask), бот в Telegram и разборы дня.
# Без него сайт работает, но кнопка «Помічник» вернёт ошибку.
DEEPSEEK_API_KEY=

# Ключ Gemini больше не используется: с нашего сервера Google отвечает
# «User location is not supported». Оставлен на случай возврата.
GEMINI_API_KEY=
