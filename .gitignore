# журнал у каждого свой — данные в репозиторий не кладём
data/trades.json
data/screenshots/*
!data/screenshots/.gitkeep
data/*.bak*
data/*.tmp
data/*.broken.*

# доступы и ключ подписи сессий
.env
data/.session_secret

__pycache__/
*.pyc
.DS_Store
Thumbs.db

# временные страницы для проверки вёрстки
static/_*.html

# посилання «поділитися» — тимчасові файли, у репозиторії не потрібні
data/shares/

# ключ доступа к Notion — на сервере, в репозиторий не кладём
data/notion.json

# ключі Notion кожного користувача — на сервері, у репозиторії не потрібні
data/notion/
